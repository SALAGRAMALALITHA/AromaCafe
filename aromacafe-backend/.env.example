# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub — add it to .gitignore.

# MongoDB Atlas connection string (see README.md for how to get this)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/aromacafe?retryWrites=true&w=majority

# Any long random string — used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API runs on locally
PORT=5000

# Your frontend's origin, so the API only accepts requests from it
# For local dev with Live Server: http://127.0.0.1:5500
# For production: set this to your hosted frontend URL (e.g. https://aroma-cafe.vercel.app)
CLIENT_ORIGIN=http://127.0.0.1:5500
